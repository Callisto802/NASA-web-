# Server-side only. Never commit a real key or paste it into client code.
# Create/rotate a key in Google AI Studio, then set it here for local development:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model. The default is set in server/gemini.mjs.
# gemini-3.5-flash-lite is fast and broadly available; try gemini-3.8-flash if your project has capacity.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: local/production port for `pnpm start`.
PORT=4173

# Set true only when a trusted host proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
